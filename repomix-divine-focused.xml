  }

  const toggleSection = (title: string) => {
    setExpandedSections((prev) => {
      if (prev.includes(title)) {
        return prev.filter((t) => t !== title);
      } else {
        return [title];
      }
    });
  };

  const handleNavClick = (sectionTitle: string) => {
