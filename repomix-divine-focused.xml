                    {live.status === 'live' && (
                      <Button
                        onClick={() => toggleLiveStatus(live)}
                        className="flex-1 bg-gray-600 hover:bg-gray-700"
                        size="sm"
                      >
                        <Pause className="h-4 w-4 mr-2" />
                        Terminer
                      </Button>
                    )}

                    <Button
                      variant="destructive"
                      size="sm"
                      onClick={() => deleteLive(live.id)}
                    >
                      <Trash2 className="h-4 w-4" />
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      )}
    </div>
  );
}
